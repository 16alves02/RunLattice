# PostgreSQL connection used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/runlattice?schema=public"

# Redis connection used by BullMQ
REDIS_URL="redis://localhost:6379"

# Optional shared secret for protected execution requests.
# Generate a long random value before exposing an environment publicly.
CRON_SECRET="replace-with-a-long-random-secret"

# AI workflow planning is disabled by default.
# Do not enable on a public deployment until authentication, workspace permissions
# and request rate limits have been implemented.
AI_ASSISTANT_ENABLED="false"
AI_API_KEY=""
AI_MODEL="gpt-4.1-mini"
