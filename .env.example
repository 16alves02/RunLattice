# PostgreSQL runtime connection and direct migration connection.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/runlattice?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/runlattice?schema=public"

# Redis connection used by BullMQ
REDIS_URL="redis://localhost:6379"

# Better Auth - generate a unique secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Generate with: openssl rand -base64 32. Required before saving provider credentials.
INTEGRATION_ENCRYPTION_KEY=""

# Google OAuth 2.0 — create a Web application client in Google Cloud Console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Must exactly match the authorized redirect URI configured in Google Cloud Console.
GOOGLE_REDIRECT_URI="http://localhost:3000/api/integrations/google/callback"

# Slack OAuth 2.0 — create a Slack app and add the chat:write bot scope.
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
# Must exactly match the Redirect URL configured in Slack.
SLACK_REDIRECT_URI="http://localhost:3000/api/integrations/slack/callback"


# AI workflow planning is disabled by default.
AI_ASSISTANT_ENABLED="false"
AI_PROVIDER="openai"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_API_KEY=""
# OpenAI defaults to gpt-4.1-mini. Set an Anthropic model when AI_PROVIDER="anthropic".
AI_MODEL="gpt-4.1-mini"
AI_MONTHLY_REQUEST_LIMIT="100"
AI_MONTHLY_TOKEN_LIMIT="100000"
# App-level AI planning limits per rolling fixed 60-second window.
AI_RATE_LIMIT_PER_USER="5"
AI_RATE_LIMIT_PER_WORKSPACE="30"
# Legacy OpenAI-only fallback; prefer OPENAI_API_KEY.
AI_API_KEY=""

# Transactional email (Resend). Required for production sign-up and password recovery.
RESEND_API_KEY=""
EMAIL_FROM="RunLattice <no-reply@your-verified-domain.example>"

# Stripe Billing — use test-mode values until a separate live launch approval.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_TEAM_MONTHLY=""
STRIPE_LIVE_MODE_ENABLED="false"
STRIPE_AUTOMATIC_TAX_ENABLED="false"

# Optional: Business monthly Stripe sandbox Price ID
STRIPE_PRICE_BUSINESS_MONTHLY=""
STRIPE_PRICE_PRO_ANNUAL=""
STRIPE_PRICE_TEAM_ANNUAL=""
STRIPE_PRICE_BUSINESS_ANNUAL=""

# Optional JSON overrides for model-to-credit weighting
AI_MODEL_CREDIT_COSTS=""

# Optional Plausible analytics. Analytics is only loaded after visitor consent.
# Set both in the hosting environment; leave empty to keep analytics disabled.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
NEXT_PUBLIC_PLAUSIBLE_SRC="https://plausible.io/js/script.js"
